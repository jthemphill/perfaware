{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/casey-intellisense/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++17",
  "files.associations": {
    "*.inl": "cpp"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.analysis.typeCheckingMode": "basic",
  "files.exclude": {
    "**/__pycache__": true
  },
  "search.exclude": {
    ".tools/**": true,
    ".venv/**": true,
    "build/**": true
  },
  "debug.saveBeforeStart": "allEditorsInActiveGroup",
  "task.saveBeforeRun": "always"
}
