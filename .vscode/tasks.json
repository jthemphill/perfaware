      "linux": {"command": "${workspaceFolder}/.venv/bin/python"},
      "args": ["part2/compare_casey.py", "check"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": "test",
      "presentation": {"reveal": "always", "clear": true, "panel": "shared", "showReuseMessage": false}
    },
