        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
