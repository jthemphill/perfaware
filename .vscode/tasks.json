{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "8086: Check all upstream listings",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/exercise.py", "check", "all"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "clear": true, "panel": "shared", "showReuseMessage": false}
    },
    {
      "label": "8086: Sync course listings",
      "type": "process",
      "command": "git",
      "args": ["submodule", "update", "--init", "--remote", "vendor/computer_enhance"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "8086: Assemble inputs",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "scripts/exercise.py",
        "assemble"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "8086: Run listing",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "scripts/exercise.py",
        "run",
        "${input:listing}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "8086: Check supported listings",
